<?xml version="1.0" encoding="UTF-8"?>
<deploy xmlns="http://www.apache.org/ode/schemas/dd/2007/03"
        xmlns:tns="http://tp.bpel/enrollment/"
        xmlns:uni="http://tp.bpel/university/"
        xmlns:bnk="http://tp.bpel/bank/"
        xmlns:res="http://tp.bpel/residence/"
        xmlns:trn="http://tp.bpel/transport/">
    <process name="tns:EnrollmentProcess">
        <active>true</active>
        <retired>false</retired>
        <process-events generate="all"/>
        <provide partnerLink="client">
            <service name="tns:EnrollmentService" port="EnrollmentPort"/>
        </provide>
        <invoke partnerLink="university">
            <service name="uni:UniversityService" port="UniversityPort"/>
        </invoke>
        <invoke partnerLink="bank">
            <service name="bnk:BankService" port="BankPort"/>
        </invoke>
        <invoke partnerLink="residence">
            <service name="res:ResidenceService" port="ResidencePort"/>
        </invoke>
        <invoke partnerLink="transport">
            <service name="trn:TransportService" port="TransportPort"/>
        </invoke>
    </process>
</deploy>

