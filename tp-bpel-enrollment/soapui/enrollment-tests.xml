        <!-- TEST CASE 1: Nominal Flow (amount <= 500,000 FCFA) -->
        <con:testCase id="tc-01-nominal" failOnError="true" failTestCaseOnErrors="true" keepSession="false" maxResults="0" name="TC01_Nominal_Enrollment_350k" searchProperties="true">
            <con:description>Nominal test: amount = 350,000 FCFA. Verifies registration, approved bank payment, parallel room allocation, and transit pass activation, returning status ENROLLED.</con:description>
            <con:settings/>
            <con:testStep type="request" id="ts-01-step" name="SOAP_Request_Nominal">
                <con:settings/>
                <con:config xsi:type="con:RequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                    <con:interface>EnrollmentSOAP</con:interface>
                    <con:operation>enroll</con:operation>
                    <con:request name="SOAP_Request_Nominal" id="req-01">
                        <con:settings/>
                        <con:encoding>UTF-8</con:encoding>
                        <con:endpoint>http://localhost:8080/ode/processes/EnrollmentService</con:endpoint>
                        <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:enr="http://tp.bpel/enrollment/">
   <soapenv:Header/>
   <soapenv:Body>
      <enr:enrollRequest>
         <student>Alice</student>
         <amount>350000</amount>
      </enr:enrollRequest>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                        <con:assertion type="SOAP Response" id="soap-res-1" name="SOAP Response Valid"/>
                        <con:assertion type="XPath Match" id="xpath-status-1" name="Check Status is ENROLLED">
                            <con:configuration>
                                <path>//*[local-name()='status']/text()</path>
                                <content>ENROLLED</content>
                                <allowWildcards>false</allowWildcards>
                                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                                <ignoreComments>false</ignoreComments>
                            </con:configuration>
                        </con:assertion>
                        <con:assertion type="XPath Match" id="xpath-room-1" name="Check Room Allocated">
                            <con:configuration>
                                <path>starts-with(//*[local-name()='roomNumber']/text(), 'ROOM-')</path>
                                <content>true</content>
                                <allowWildcards>false</allowWildcards>
                                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                                <ignoreComments>false</ignoreComments>
                            </con:configuration>
                        </con:assertion>
                        <con:assertion type="XPath Match" id="xpath-pass-1" name="Check Transit Pass Activated">
                            <con:configuration>
                                <path>starts-with(//*[local-name()='passId']/text(), 'PASS-')</path>
                                <content>true</content>
                                <allowWildcards>false</allowWildcards>
                                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                                <ignoreComments>false</ignoreComments>
                            </con:configuration>
                        </con:assertion>
                        <con:assertion type="XPath Match" id="xpath-receipt-1" name="Check Bank Receipt Issued">
                            <con:configuration>
                                <path>starts-with(//*[local-name()='receipt']/text(), 'RCT-')</path>
                                <content>true</content>
                                <allowWildcards>false</allowWildcards>
                                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                                <ignoreComments>false</ignoreComments>
                            </con:configuration>
                        </con:assertion>
                        <con:credentials><con:authType>No Authorization</con:authType></con:credentials>
                        <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
                        <con:wsaConfig action="enroll"/>
                    </con:request>
                </con:config>
            </con:testStep>
        </con:testCase>

